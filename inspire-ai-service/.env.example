ENVIRONMENT=dev
AI_SERVICE_MODE=food_chat

APP_HOST=0.0.0.0
APP_PORT=8000

LLM__PROVIDER=gemini
LLM__GEMINI__API_KEY=
LLM__GEMINI__MODEL_NAME=gemini-2.0-flash-lite
LLM__GEMINI__EMBED_MODEL=text-embedding-004
LLM__GEMINI__TEMPERATURE=0.7
LLM__GEMINI__MAX_TOKENS=2048

# Optional OpenAI alternative
LLM__OPENAI__API_KEY=
LLM__OPENAI__MODEL_NAME=gpt-4.1-mini
LLM__OPENAI__EMBED_MODEL=text-embedding-3-small
LLM__OPENAI__EMBEDDING_DIMENSIONS=1536
LLM__OPENAI__TEMPERATURE=0.7
LLM__OPENAI__MAX_TOKENS=2048

INFRA__FILE_STORAGE__TYPE=local
INFRA__FILE_STORAGE__DATA_DIR=data
INFRA__FILE_STORAGE__STATIC_DIR=static

# Optional full-mode infrastructure
INFRA__VECTOR_STORE__TYPE=qdrant
INFRA__VECTOR_STORE__URL=http://localhost:6333
INFRA__VECTOR_STORE__API_KEY=
INFRA__VECTOR_STORE__COLLECTION=sugfoodapp
INFRA__VECTOR_STORE__VECTOR_SIZE=1536

INFRA__TASK_QUEUE__TYPE=celery
INFRA__TASK_QUEUE__MESSAGE_BROKER=redis://localhost:6379/0
INFRA__TASK_QUEUE__RESULT_BACKEND=redis://localhost:6379/1

# Optional callbacks used by background jobs in full mode
AI_SERVICE__URL=http://localhost:3000
AI_SERVICE__PRODUCTION_URL=
AI_SERVICE__SECRET_KEY=secret
