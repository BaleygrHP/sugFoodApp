# Environment Configuration
ENVIRONMENT=

# Server Configuration
APP_HOST=
APP_PORT=

# LLM Provider Configuration (choose "gemini" or "openai")
LLM__PROVIDER=

# Gemini Configuration
LLM__GEMINI__MODEL_NAME=
LLM__GEMINI__EMBED_MODEL=
LLM__GEMINI__API_KEY=
LLM__GEMINI__TEMPERATURE=
LLM__GEMINI__MAX_TOKENS=
LLM__AGENTIC_GEMINI__MODEL_NAME=
LLM__AGENTIC_GEMINI__TEMPERATURE=
LLM__AGENTIC_GEMINI__MAX_TOKENS=
# Tool Execution Temperature (for agents with tools)
# IMPORTANT: Set to 0.0 for deterministic tool execution
# This ensures agents performing multi-step tool workflows (e.g., query vector DB → extract IDs → call API)
# produce consistent, reliable results. Higher values (>0.0) can cause non-deterministic behavior.
LLM__AGENTIC_GEMINI__TOOL_EXECUTION_TEMPERATURE=

# Gemini Configuration for OCR
LLM__OCR_GEMINI__MODEL_NAME=
LLM__OCR_GEMINI__API_KEY=
LLM__OCR_GEMINI__TEMPERATURE=

# OpenAI Configuration (Alternative LLM Provider)
# Uncomment and configure if using LLM__PROVIDER=
# LLM__OPENAI__MODEL_NAME=
# LLM__OPENAI__API_KEY=
# LLM__OPENAI__EMBED_MODEL=
# LLM__OPENAI__EMBEDDING_DIMENSIONS=
# LLM__OPENAI__TEMPERATURE=
# LLM__OPENAI__MAX_TOKENS=
# Tool Execution Temperature (for agents with tools)
# IMPORTANT: Set to 0.0 for deterministic tool execution (see Gemini config above for details)
# LLM__OPENAI__TOOL_EXECUTION_TEMPERATURE=

# LLM Index Settings
LLM__INDEX__CHUNK_SIZE=
LLM__INDEX__CHUNK_OVERLAP=

# Workflow Configuration
# Maximum retry attempts for transient failures (network, timeout) in tool execution
WORKFLOW__MAX_RETRY_ATTEMPTS=
# Base backoff time in seconds for exponential backoff (attempt 1: 1s, attempt 2: 2s, attempt 3: 4s)
WORKFLOW__RETRY_BACKOFF_BASE=
# Parallel agent execution timeout (seconds per agent)
WORKFLOW__PARALLEL_AGENT_TIMEOUT=
# Knowledge base query timeout (seconds)
WORKFLOW__KNOWLEDGE_TIMEOUT=
# Knowledge base top-K retrieval count
WORKFLOW__KNOWLEDGE_TOP_K=
# LLM response generation timeout (seconds)
WORKFLOW__LLM_TIMEOUT=
# Maximum images to attach to LLM prompts
WORKFLOW__MAX_IMAGE_ATTACH=
# Maximum tool call iterations per agent (prevents infinite loops)
WORKFLOW__MAX_AGENT_ITERATIONS=

# Vector Store Configuration
INFRA__VECTOR_STORE__TYPE=
INFRA__VECTOR_STORE__URL=
INFRA__VECTOR_STORE__API_KEY=
INFRA__VECTOR_STORE__COLLECTION=
INFRA__VECTOR_STORE__VECTOR_SIZE=

# File Storage Configuration
INFRA__FILE_STORAGE__TYPE=
INFRA__FILE_STORAGE__DATA_DIR=
INFRA__FILE_STORAGE__STATIC_DIR=

# Task Queue Configuration
INFRA__TASK_QUEUE__TYPE=
INFRA__TASK_QUEUE__MESSAGE_BROKER=
INFRA__TASK_QUEUE__RESULT_BACKEND=
INFRA__TASK_QUEUE__POOL_TYPE=
INFRA__TASK_QUEUE__MAX_TASK_PER_CHILDS=
INFRA__TASK_QUEUE__CONCURRENCY=
INFRA__TASK_QUEUE__SCHEDULED_HOUR=
INFRA__TASK_QUEUE__SCHEDULED_MINUTE=

# AI Service Configuration
AI_SERVICE__URL=
AI_SERVICE__PRODUCTION_URL=
AI_SERVICE__SECRET_KEY=

# Google Drive Configuration
INFRA__GOOGLE_API__CLIENT_ID=
INFRA__GOOGLE_API__CLIENT_SECRET=
INFRA__GOOGLE_API__SERVICE_ACCOUNT_JSON=
